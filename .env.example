# Plantilla de configuración. Copia este archivo como ".env" y llena los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# Clave secreta de Django: genera una con
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL 18
POSTGRES_DB=suministros
POSTGRES_USER=suministros
POSTGRES_PASSWORD=cambia-esto
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
